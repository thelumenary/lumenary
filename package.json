{
  "name": "lumenary",
  "version": "0.1.0",
  "private": true,
  "description": "The Lumenary \u2014 a free, open-source mathematics education platform. One mathematics. Many languages. Every nation.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/build-lean-bundles.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-lean-bundles.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:lean": "node scripts/verify-lean.mjs",
    "verify:compute": "node scripts/verify-compute.mjs",
    "verify": "npm run verify:lean && npm run verify:compute && npm run typecheck && npm run test:report",
    "screenshots": "node scripts/screenshots.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=content/verification/vitest-report.json",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "gray-matter": "4.0.3",
    "katex": "0.16.47",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
