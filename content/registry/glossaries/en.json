      "term": "intersection",
      "alternatives": []
    },
    "complement": {
      "term": "complement",
      "alternatives": [
        "absolute complement",
        "relative complement"
      ],
      "note": "The complement is always relative to a stated universal set; A \\ B is the relative complement (set difference)."
    },
    "cardinality": {
      "term": "cardinality",
      "alternatives": [
        "number of elements",
        "size"
      ],
      "note": "'Size' is acceptable only for finite sets in early lessons."
