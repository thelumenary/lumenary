      "term": "element",
      "alternatives": []
    },
    "member": {
      "term": "member",
      "alternatives": [],
      "note": "Synonym of 'element'; 'x belongs to A' / 'x is in A' for x ∈ A."
    },
    "empty-set": {
      "term": "empty set",
      "alternatives": [
        "null set"
      ]
    },
    "subset": {
      "term": "subset",
      "alternatives": [],
      "note": "Lessons must say whether 'subset' allows equality (A ⊆ B) and use 'proper subset' for A ⊊ B."
    },
    "union": {
      "term": "union",
      "alternatives": []
    },
