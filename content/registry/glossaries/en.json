      ]
    },
    "integer": {
      "term": "integer",
      "alternatives": [],
      "note": "'Whole number' is ambiguous (it means non-negative integers in some curricula and integers in others); avoid it in definitions."
    },
    "natural-number": {
      "term": "natural number",
      "alternatives": [
        "counting number"
      ],
      "note": "Whether 0 is a natural number varies by country, curriculum and author. Every Lumenary lesson must state its convention explicitly."
    },
    "negative-number": {
      "term": "negative number",
      "alternatives": []
    },
